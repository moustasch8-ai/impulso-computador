# Copie este arquivo para .env e preencha localmente. NUNCA faça commit do .env.
INSTAGRAM_APP_ID=SEU_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=SEU_INSTAGRAM_APP_SECRET
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_API_VERSION=v27.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
SESSION_SECRET=gere-uma-chave-aleatoria-longa-com-no-minimo-32-caracteres
PORT=3000
NODE_ENV=development
